# Copy this file to .env and fill in your values. Never commit .env.

# ---------- Database (MongoDB Atlas — required) ----------
# Atlas → Database → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# Database name inside the cluster (created automatically)
MONGODB_DB=aurum

# ---------- Server ----------
# Local only (Vercel ignores it)
PORT=5173
# "production" makes the admin login cookie HTTPS-only
NODE_ENV=development
# Public URL of this backend (used in email links: confirm, unsubscribe, admin inbox)
PUBLIC_API_URL=http://localhost:5173
# Public URL of the Next.js website (used for redirects and links in emails)
SITE_URL=http://localhost:3000
# Brand name used in emails
SITE_NAME=Aurum Markets
# Websites allowed to call the public API directly from the browser (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ---------- First admin account (used only when the database is empty) ----------
ADMIN_EMAIL=admin@aurum.local
# Required on Vercel. Locally, leave empty to generate a random password into data/first-login.txt
# Only used the first time, when the database has no admin yet.
ADMIN_PASSWORD=

# ---------- Email (any SMTP provider: Brevo, Mailgun, SendGrid, Amazon SES, Gmail…) ----------
# Leave SMTP_HOST empty in development: emails are saved to data/outbox/ instead of being sent
# (on Vercel without SMTP, emails are not sent at all).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to readers. Use a domain you have verified with your provider.
EMAIL_FROM="Aurum Markets" <news@yourdomain.com>
# Where new contact-form messages are forwarded (leave empty to skip)
ADMIN_NOTIFY_EMAIL=

# ---------- Market data (https://twelvedata.com — free plan works) ----------
# Leave empty to show sample prices, clearly labelled "Illustrative sample".
TWELVE_DATA_API_KEY=
# Prices are cached and refreshed on the first request after this many minutes (minimum 5).
# 20 keeps the free plan under its daily limit.
MARKET_REFRESH_MINUTES=20
